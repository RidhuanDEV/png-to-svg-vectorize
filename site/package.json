{
  "name": "pngsvg-site",
  "version": "1.0.0",
  "private": true,
  "description": "Product website of PNG to SVG Vectorize (static export for GitHub Pages)",
  "scripts": {
    "content": "node scripts/content.mjs",
    "dev": "npm run content && next dev",
    "build": "npm run content && next build && node scripts/flatten-segments.mjs",
    "typecheck": "npm run content && next typegen && tsc --noEmit",
    "lint": "eslint",
    "check": "npm run typecheck && npm run lint"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "marked": "18.1.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
